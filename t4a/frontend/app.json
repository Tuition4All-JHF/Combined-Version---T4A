{
  "expo": {
    "name": "Tuition4All",
    "slug": "Tuition4All",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash":{
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor":"#F0EEFF"
    },
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bitcode": false
    },
    "android": {
      "package": "com.tuition4all.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/app-icon-new.png",
        "backgroundColor": "#F0EEFF"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.CAMERA",
        "android.permission.INTERNET",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WAKE_LOCK",
        "android.permission.BLUETOOTH"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera for live classes",
          "microphonePermission": "Allow $(PRODUCT_NAME) to access your microphone for live classes"
        }
      ],
      "expo-video"
    ],
    "extra": {
      "eas": {
        "projectId": "71107579-4ade-472a-aece-4715a7e5138a"
      }
    }
  }
}
